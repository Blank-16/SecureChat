# Server port
PORT=4000

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://securechat:changeme@localhost:5432/securechat

# Comma-separated list of origins allowed to connect via CORS and
# WebSocket. Required — the server refuses to start without this set.
# In production, every origin must use https://.
ALLOWED_ORIGINS=http://localhost:5173

# Origin used in legacy CLIENT_ORIGIN-based contexts; falls back to the
# first entry in ALLOWED_ORIGINS if omitted.
CLIENT_ORIGIN=http://localhost:5173

# How many days a session cookie / server-side session row remains valid.
SESSION_TTL_DAYS=30

# development | production — production enforces https:// in
# ALLOWED_ORIGINS at boot.
NODE_ENV=development
